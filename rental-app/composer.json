{
  "name": "rental/vehicle-rental-app",
  "description": "Sistem Rental Kendaraan menggunakan CodeIgniter 4",
  "require": {
    "php": "^7.4 || ^8.0",
    "codeigniter4/framework": "4.4.8",
    "psr/log": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app",
      "Config\\": "app/Config"
    }
  },
  "scripts": {
    "serve": "php spark serve",
    "test": "phpunit"
  },
  "config": {
    "audit": {
      "block-insecure": false
    }
  }
}
